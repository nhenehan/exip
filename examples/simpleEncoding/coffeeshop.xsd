<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://example.com/coffeeshop"
           xmlns="http://example.com/coffeeshop"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <xs:element name="CoffeeShop">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="shopName" type="xs:string"/>
        <xs:element name="isOpen" type="xs:boolean"/>
        <xs:element name="menuItem" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="name" type="xs:string"/>
              <xs:element name="priceCents" type="xs:int"/>
              <xs:element name="seasonal" type="xs:boolean"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
