# Code size per exip library: cmake -DSIZE_TOOL=<size> -DLIBS=<lib;lib...> -P size-report.cmake
# Runs "<size> -t" (berkeley format) on each static library and prints its totals.
if(NOT SIZE_TOOL OR NOT LIBS)
    message(FATAL_ERROR "usage: cmake -DSIZE_TOOL=<size> -DLIBS=<lib;...> -P size-report.cmake")
endif()

set(_sum_text 0)
set(_sum_data 0)
set(_sum_bss 0)
message("      text      data       bss  library")
foreach(_lib IN LISTS LIBS)
    execute_process(COMMAND ${SIZE_TOOL} -t ${_lib}
        OUTPUT_VARIABLE _out RESULT_VARIABLE _rc ERROR_VARIABLE _err)
    if(NOT _rc EQUAL 0)
        message(FATAL_ERROR "${SIZE_TOOL} failed on ${_lib}: ${_err}")
    endif()
    if(NOT _out MATCHES "[ \t]*([0-9]+)[ \t]+([0-9]+)[ \t]+([0-9]+)[ \t]+[0-9]+[ \t]+[0-9a-fA-F]+[ \t]+\\(TOTALS\\)")
        message(FATAL_ERROR "no totals in the ${SIZE_TOOL} output for ${_lib}")
    endif()
    set(_text ${CMAKE_MATCH_1})
    set(_data ${CMAKE_MATCH_2})
    set(_bss ${CMAKE_MATCH_3})
    math(EXPR _sum_text "${_sum_text} + ${_text}")
    math(EXPR _sum_data "${_sum_data} + ${_data}")
    math(EXPR _sum_bss "${_sum_bss} + ${_bss}")
    get_filename_component(_name "${_lib}" NAME)
    foreach(_v _text _data _bss)
        string(LENGTH "${${_v}}" _len)
        math(EXPR _pad "10 - ${_len}")
        string(REPEAT " " ${_pad} _p)
        set(${_v} "${_p}${${_v}}")
    endforeach()
    message("${_text}${_data}${_bss}  ${_name}")
endforeach()
foreach(_v _sum_text _sum_data _sum_bss)
    string(LENGTH "${${_v}}" _len)
    math(EXPR _pad "10 - ${_len}")
    string(REPEAT " " ${_pad} _p)
    set(${_v} "${_p}${${_v}}")
endforeach()
message("${_sum_text}${_sum_data}${_sum_bss}  (all libraries; a firmware links only what it uses)")
